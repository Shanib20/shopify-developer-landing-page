<section class="brand-story" id="our-story">
  {% for block in section.blocks %}
    {% assign default_asset = block.settings.heading | handleize | prepend: 'story-' | append: '.png' %}
    <div class="container brand-story__row {% cycle 'brand-story__row--image-left', 'brand-story__row--image-right' %}">
      <div class="brand-story__media reveal">
        {% if block.settings.image %}
          {{ block.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '500,1000', alt: block.settings.heading }}
        {% else %}
          <img src="{{ default_asset | asset_url }}" alt="{{ block.settings.heading }}" loading="lazy" width="1000" height="1250">
        {% endif %}
      </div>
      <div class="brand-story__content reveal">
        <p class="eyebrow">{{ forloop.index | prepend: '0' | slice: -2, 2 }} — {{ block.settings.eyebrow }}</p>
        <h2 class="h2">{{ block.settings.heading }}</h2>
        <p class="body-text">{{ block.settings.body }}</p>
        {% if block.settings.link_label != blank %}
          <a href="{{ block.settings.link_url | default: '#' }}" class="text-link">{{ block.settings.link_label }} {% render 'icon-caret', direction: 'right', size: 14 %}</a>
        {% endif %}
      </div>
    </div>
  {% endfor %}
</section>

{{ 'brand-story.css' | asset_url | stylesheet_tag }}

{% schema %}
{
  "name": "Brand story",
  "blocks": [
    {
      "type": "story",
      "name": "Story block",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Craft" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Rooted in Craft" },
        { "type": "textarea", "id": "body", "label": "Body", "default": "Every piece is made with techniques passed down through generations." },
        { "type": "text", "id": "link_label", "label": "Link label", "default": "Discover the Story" },
        { "type": "url", "id": "link_url", "label": "Link URL" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "story", "settings": { "eyebrow": "The Craft", "heading": "Rooted in Craft", "body": "Every piece is made with techniques passed down through generations.", "link_label": "Discover the Story" } },
      { "type": "story", "settings": { "eyebrow": "The Materials", "heading": "Made to Last", "body": "We choose materials for how they age, not just how they look on day one.", "link_label": "See Our Process" } },
      { "type": "story", "settings": { "eyebrow": "The Silhouette", "heading": "A Modern Heritage", "body": "Classic silhouettes, reimagined for how you actually dress today.", "link_label": "Explore the Edit" } }
    ]
  },
  "presets": [
    {
      "name": "Brand story",
      "blocks": [
        { "type": "story", "settings": { "eyebrow": "The Craft", "heading": "Rooted in Craft", "body": "Every piece is made with techniques passed down through generations.", "link_label": "Discover the Story" } },
        { "type": "story", "settings": { "eyebrow": "The Materials", "heading": "Made to Last", "body": "We choose materials for how they age, not just how they look on day one.", "link_label": "See Our Process" } },
        { "type": "story", "settings": { "eyebrow": "The Silhouette", "heading": "A Modern Heritage", "body": "Classic silhouettes, reimagined for how you actually dress today.", "link_label": "Explore the Edit" } }
      ]
    }
  ]
}
{% endschema %}

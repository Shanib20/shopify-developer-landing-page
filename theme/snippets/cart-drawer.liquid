<div class="cart-drawer" data-cart-drawer hidden>
  <div class="cart-drawer__backdrop" data-cart-drawer-backdrop></div>
  <div class="cart-drawer__panel" role="dialog" aria-modal="true" aria-label="Shopping cart" id="cart-drawer-panel">
    <div class="cart-drawer__header">
      <h2 class="h2">Your Cart</h2>
      <button type="button" class="cart-drawer__close" data-cart-drawer-close aria-label="Close cart">
        {% render 'icon-close' %}
      </button>
    </div>
    <div class="cart-drawer__items" data-cart-drawer-items></div>
    <p class="cart-drawer__empty" data-cart-drawer-empty hidden>Your cart is empty.</p>
    <div class="cart-drawer__footer" data-cart-drawer-footer hidden>
      <div class="cart-drawer__subtotal">
        <span>Subtotal</span>
        <span data-cart-drawer-subtotal>{{ 0 | money }}</span>
      </div>
      <a href="{{ routes.cart_url }}" class="btn btn--primary cart-drawer__checkout">Checkout</a>
    </div>
  </div>
</div>

{{ 'cart-drawer.css' | asset_url | stylesheet_tag }}
<script src="{{ 'cart.js' | asset_url }}" defer></script>

<article class="product-card" data-product-collections="{{ product.collections | map: 'handle' | join: ',' }}" data-quick-view-description="{{ product.description | strip_html | truncate: 180 }}">
  <div class="product-card__media">
    <a href="{{ product.url }}" class="product-card__image-link" aria-label="View {{ product.title }}">
      {% if product.featured_image %}
        {{ product.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300,600', alt: product.title, class: 'product-card__image--primary' }}
        {% if product.images.size > 1 %}
          {{ product.images[1] | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300,600', alt: product.title, class: 'product-card__image--secondary' }}
        {% endif %}
      {% else %}
        <div class="product-card__placeholder" role="img" aria-label="{{ product.title }}"></div>
      {% endif %}
    </a>
    <div class="product-card__badges">
      {% if product.compare_at_price > product.price %}
        <span class="product-card__badge product-card__badge--sale">Sale</span>
      {% endif %}
      {% if product.tags contains 'new' %}
        <span class="product-card__badge product-card__badge--new">New</span>
      {% endif %}
    </div>
    <button type="button" class="product-card__wishlist" data-wishlist-toggle data-product-id="{{ product.id }}" aria-label="Add {{ product.title }} to wishlist" aria-pressed="false">
      <span class="product-card__wishlist-icon product-card__wishlist-icon--outline">{% render 'icon-heart', size: 18 %}</span>
      <span class="product-card__wishlist-icon product-card__wishlist-icon--filled">{% render 'icon-heart', size: 18, filled: true %}</span>
    </button>
    <button type="button" class="product-card__quick-view" data-quick-view-trigger>Quick View</button>
  </div>
  <h3 class="product-card__title"><a href="{{ product.url }}">{{ product.title }}</a></h3>
  <div class="product-card__price-row">
    <p class="product-card__price">{{ product.price | money }}</p>
    {% if product.compare_at_price > product.price %}
      <p class="product-card__compare-price">{{ product.compare_at_price | money }}</p>
    {% endif %}
  </div>
  {% form 'product', product %}
    <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
    <button type="submit" class="btn btn--primary product-card__add" {% unless product.available %}disabled{% endunless %}>
      {% render 'icon-cart-small' %} {% if product.available %}Add to Cart{% else %}Sold Out{% endif %}
    </button>
  {% endform %}
</article>

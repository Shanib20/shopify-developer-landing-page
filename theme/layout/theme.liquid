<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>{{ page_title }}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant:wght@500;600;700&family=Montserrat:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  {{ 'tokens.css' | asset_url | stylesheet_tag }}
  {{ 'base.css' | asset_url | stylesheet_tag }}
  <script>
    window.theme = {
      moneyFormat: {{ shop.money_format | json }},
      routes: { cartUrl: {{ routes.cart_url | json }} }
    };
  </script>
  <noscript><style>.reveal { opacity: 1 !important; transform: none !important; }</style></noscript>
  {{ content_for_header }}
</head>
<body>
  {{ content_for_layout }}
  {% render 'cart-drawer' %}
  {% render 'quick-view-modal' %}
  <script src="{{ 'reveal.js' | asset_url }}" defer></script>
</body>
</html>
